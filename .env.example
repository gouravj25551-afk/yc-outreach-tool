# Copy this file to .env.local (Vercel) or just .env (local scripts) and fill in your own values.

# Password that gates the whole site (sent as X-Pass header). Required.
SITE_PASSWORD=

# Apify token, used by apify_enrich.py to enrich scraped founder data.
APIFY_TOKEN=

# Gmail address drafts/sends are made from.
GMAIL_USER=

# Simplest auth: one Gmail account + its app password (Google Account -> Security -> App passwords).
GMAIL_APP_PASSWORD=

# Alternative to GMAIL_APP_PASSWORD: multiple sending accounts, as a JSON array,
# so you can spread sends across accounts once one hits its daily cap.
# Example: [{"email":"a@gmail.com","password":"app-password","cap":20},{"email":"b@gmail.com","password":"app-password","cap":20}]
GMAIL_ACCOUNTS=

# Vercel Blob read/write token, used to persist the outreach tracker across devices.
# Set automatically when you link a Blob store on Vercel; locally run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
